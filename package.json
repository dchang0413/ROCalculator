{
  "name": "rocalculator",
  "version": "2.0.0",
  "description": "A modular Ragnarok Online build calculator built with Vue 3, Vite, TypeScript, and Tailwind CSS.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "vue-tsc -b"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evertonfragoso/ROCalculator.git"
  },
  "originalRepository": {
    "type": "git",
    "url": "git+https://github.com/Landgris/ROCalculator.git"
  },
  "author": "Everton Fragoso (forked from Landgris)",
  "license": "GPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/evertonfragoso/ROCalculator/issues"
  },
  "homepage": "https://evertonfragoso.github.com/ROCalculator/",
  "dependencies": {
    "@vitejs/plugin-vue": "latest",
    "@vueuse/core": "latest",
    "vite": "latest",
    "vue": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@tailwindcss/vite": "latest",
    "@types/node": "latest",
    "@vue/eslint-config-typescript": "latest",
    "@vue/test-utils": "latest",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "latest",
    "eslint-plugin-vue": "latest",
    "happy-dom": "latest",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vitest": "latest",
    "vue-tsc": "latest"
  }
}
