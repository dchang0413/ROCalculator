{
  "name": "rocalculator",
  "version": "2.0.0",
  "description": "A modular Ragnarok Online build calculator built with Vue 3, Vite, TypeScript, and Tailwind CSS.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "vue-tsc -b"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evertonfragoso/ROCalculator.git"
  },
  "originalRepository": {
    "type": "git",
    "url": "git+https://github.com/Landgris/ROCalculator.git"
  },
  "author": "Everton Fragoso (forked from Landgris)",
  "license": "GPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/evertonfragoso/ROCalculator/issues"
  },
  "homepage": "https://evertonfragoso.github.com/ROCalculator/",
  "dependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "@vueuse/core": "^14.3.0",
    "vite": "^8.0.13",
    "vue": "latest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^25.9.0",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/test-utils": "^2.4.10",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.4.0",
    "eslint-plugin-vue": "^10.9.1",
    "happy-dom": "^20.9.0",
    "tailwindcss": "latest",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6",
    "vue-tsc": "^3.3.0"
  }
}
